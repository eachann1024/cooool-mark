{
  "name": "Cooool Mark",
  "slug": "cooool-mark",
  "identifier": "app.cooool.mark",
  "version": "1.0.14",
  "copyright": "Copyright © 2026 Cooool Mark Contributors",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "out": "build",
  "i18n": {
    "dir": "internal/locales",
    "source": "en"
  },
  "urlSchemes": [
    "coooolmark"
  ],
  "fileAssociations": [
    {
      "ext": [
        "html",
        "htm"
      ],
      "name": "HTML Bookmarks",
      "mimeType": "text/html",
      "role": "Viewer"
    },
    {
      "ext": [
        "json"
      ],
      "name": "Cooool Mark Backup",
      "mimeType": "application/json",
      "role": "Viewer"
    }
  ],
  "macos": {
    "minimumSystemVersion": "12.0",
    "signingIdentity": "-",
    "dmgTitle": "Cooool Mark"
  },
  "linux": {
    "categories": [
      "Utility"
    ]
  },
  "ios": {
    "minimumSystemVersion": "17.0"
  },
  "android": {
    "minSdk": 26
  }
}
